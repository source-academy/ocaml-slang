opam-version: "2.0"
name: "ocaml-slang"
version: "dev"
synopsis:
  "OCaml for Source Academy: the OCaml toplevel compiled to JavaScript"
maintainer: "Source Academy"
authors: "Source Academy"
license: "Apache-2.0"
homepage: "https://github.com/source-academy/ocaml-slang"
bug-reports: "https://github.com/source-academy/ocaml-slang/issues"
depends: [
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "cmdliner" {= "2.1.2"}
  "compiler-cloning" {= "enabled"}
  "dune" {= "3.25.0"}
  "gen" {= "1.1"}
  "js_of_ocaml" {= "6.5.0"}
  "js_of_ocaml-compiler" {= "6.5.0"}
  "js_of_ocaml-ppx" {= "6.5.0"}
  "js_of_ocaml-toplevel" {= "6.5.0"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "ocaml" {= "5.5.2"}
  "ocaml-base-compiler" {= "5.5.2"}
  "ocaml-compiler" {= "5.5.2"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocamlfind" {= "1.9.9~preview"}
  "ppx_derivers" {= "1.2.1"}
  "ppxlib" {= "0.39.0"}
  "sedlex" {= "3.8.1"}
  "seq" {= "base"}
  "sexplib0" {= "v0.17.0"}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/source-academy/ocaml-slang.git"
x-maintenance-intent: ["(latest)"]