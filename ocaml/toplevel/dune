; The OCaml toplevel, with MenhirLib linked in, as one JavaScript file: _build/default/ocaml/toplevel/toplevel.bc.js
; It must be built with --profile release (see CLAUDE.md); the bytecode is -linkall'd so that
; compiler-libs, Stdlib and MenhirLib are available to the phrases that run.
(executable
 (name toplevel)
 (modes byte js)
 (link_flags (-linkall))
 (ocamlc_flags (:standard -g))
 (js_of_ocaml
  (flags (:standard --toplevel))
  (javascript_files stubs.js))
 (preprocess (pps js_of_ocaml-ppx))
 (libraries js_of_ocaml-compiler.runtime js_of_ocaml js_of_ocaml-toplevel
  compiler-libs.toplevel menhirLib))
